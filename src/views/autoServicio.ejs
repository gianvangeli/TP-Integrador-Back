
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bienvenida - Autoservicio</title>

    <!-- Estilos del proyecto -->
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.css">
    <link rel="stylesheet" href="/css/styles.css">

</head>

<!-- JavaScript que controla el tema -->
<script src="/js/tema.js"></script>
<body>

    <!-- ==============================
         ENCABEZADO
    ============================== -->

    <header>

        <h1>Autoservicio</h1>

        <nav>
            <a href="/">Inicio</a>
            <a href="/productos">Productos</a>
            <a href="/carrito">Mi carrito</a>
            <a href="/login">Administrador</a>
            

            <!-- Botón para cambiar entre modo claro y oscuro -->
            <button type="button" id="btnCambiarTema">
                🌙 Modo oscuro
            </button>
        </nav>

    </header>


    <main>

        <!-- ==============================
             PANTALLA DE BIENVENIDA
        ============================== -->

        <section id="bienvenida">

            <h2>Bienvenido a nuestro Autoservicio</h2>

            <p>Ingresá tu nombre para comenzar tu compra.</p>

            <form id="formBienvenida">

                <label for="nombreCliente">
                    Tu nombre
                </label>

                <input
                    type="text"
                    id="nombreCliente"
                    name="nombreCliente"
                    placeholder="Ingresá tu nombre"
                    required
                    maxlength="100"
                >

                <button type="submit">
                    Comenzar compra
                </button>

            </form>

        </section>

    </main>


    <!-- ==============================
         JAVASCRIPT
    ============================== -->

    <script>

        // Buscamos el formulario de bienvenida
        const formBienvenida = document.getElementById("formBienvenida");

        // Detectamos cuando el cliente comienza su compra
        formBienvenida.addEventListener("submit", (event) => {

            // Evitamos que el formulario recargue la página
            event.preventDefault();

            // Obtenemos el nombre ingresado
            const nombreCliente = document
                .getElementById("nombreCliente")
                .value
                .trim();

            // Verificamos que haya ingresado un nombre
            if (!nombreCliente) {
                alert("Por favor, ingresá tu nombre.");
                return;
            }

            // Guardamos el nombre del cliente
            sessionStorage.setItem("nombreCliente", nombreCliente);

            // Iniciamos un carrito vacío para la nueva compra
            sessionStorage.setItem("carrito", JSON.stringify([]));

            // Enviamos al cliente a la pantalla de productos
            window.location.href = "/productos";

        });

    </script>

        <!-- Pie de página -->
    <footer class="footer-autoservicio">
        <p>Autoservicio | Trabajo Práctico Integrador</p>
        <p>Desarrollado por: Gianlukas Vangeli</p>
        <p>Programación III - 2026</p>
    </footer>

</body>

</html>
